  "THE_ARCHITECT.talk.STS2_CHARLOTTE_CHARACTER_CHARLOTTE.0-1r.next": "继续",
  "THE_ARCHITECT.talk.STS2_CHARLOTTE_CHARACTER_CHARLOTTE.0-2r.char": "诶——请等一下啊！",
